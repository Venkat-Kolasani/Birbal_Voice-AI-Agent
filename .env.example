# Minimum for typed interviews: GOOGLE_API_KEY or GROQ_API_KEY
# Minimum for voice: an STT key (Deepgram or Sarvam) + an LLM key + the TTS provider's key
# Any key may be a comma-separated pool, e.g. GOOGLE_API_KEYS=k1,k2. Rate-limited keys rest 60 s; then next key / provider.
# Check provider terms before pooling keys from several accounts (Google APIs ToS 2(d): no circumventing limits).
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# Who does what. Talker = fast model (asks questions); Scribe = strong model (takes notes, off the hot path)
TALKER_PROVIDER=groq
SCRIBE_PROVIDER=alt
TALKER_TEMPERATURE=0.4
GEMINI_MODEL=gemini-flash-lite-latest       # Scribe. 3.6-flash hit its free daily quota after ~40 calls on 2026-10-18
GEMINI_TALKER_MODEL=gemini-flash-lite-latest   # Talker (fast: ~0.9 s per reply measured)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Languages: chosen per interview on the start screen (Auto / English / हिंदी / ಕನ್ನಡ). Brief is always English.
# Hindi/Kannada voice uses Sarvam TTS automatically; Kannada speech uses Sarvam STT automatically.
# Speech-to-text: deepgram (multi = Hindi/English code-switching) | sarvam (saaras, codemix keeps Hinglish verbatim)
STT_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix

# Text-to-speech: aura (dev, uses Deepgram credit) | sarvam (demo voice) | elevenlabs (alternate)
TTS_PROVIDER=aura
AURA_VOICE=aura-2-helena-en
SARVAM_VOICE=shubh
SARVAM_LANGUAGE=en-IN
SARVAM_PACE=1.0
ELEVENLABS_VOICE_ID=

# Turn-taking (listening). Smart-turn (bundled) judges if a sentence is finished; VAD only needs a short pause.
# Lower = faster replies; raise toward 0.8 if Birbal cuts people off mid-thought.
VAD_STOP_SECS=0.4
BARGE_IN_MIN_WORDS=2   # also gates turn START: if a one-word answer ("Yes.", "Haan.") hangs, set 1
IDLE_NUDGE_SECS=8

# Where finished interviews are stored (gitignored; may contain real names)
# BIRBAL_DATA=data/sessions

# Supabase (hosted session store + problem board). Project Settings -> API.
SUPABASE_URL=
# service_role key (server-side only; never the anon key in the browser, never in chat)
SUPABASE_KEY=

# GitHub "problem board" issue on Approve (optional). Fine-grained token with Issues: write on that repo only.
GITHUB_TOKEN=
GITHUB_REPO=Venkat-Kolasani/birbal-problems

# Third LLM provider, any OpenAI-compatible endpoint. Default: Command Code (commandcode.ai) gpt-5.6-luna: fastest model there that still grades correctly
ALT_LLM_KEY=
ALT_LLM_BASE=https://api.commandcode.ai/provider/v1
ALT_LLM_MODEL=gpt-5.6-luna

# TURN relay (needed for voice when deployed to a cloud host; not needed on a laptop or LAN).
# Metered (metered.ca, free plan) or Cloudflare TURN. Comma-separated URLs, e.g. turn:x:80,turns:x:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
